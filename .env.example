# Falcon Housing ERP — Environment

# PostgreSQL connection string (required for migrations & auth)
# Prefer Neon *pooler* host in runtime. Do not include channel_binding=require
# (Prisma cannot handshake it and logs Closed connections). The app adds
# pgbouncer=true, sslmode, and a small connection_limit when missing.
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/falcon_housing?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Falcon Housing"

# Module 1 — Authentication (Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Resend email (password reset and transactional mail)
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="onboarding@resend.dev"

# Bootstrap admin (used by pnpm db:seed:auth)
BOOTSTRAP_ADMIN_EMAIL="admin@falcon.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_NAME="System Admin"

# Later modules
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
