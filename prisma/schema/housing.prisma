// Module 7 — House Types, Templates & Houses

enum HouseTypeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum HouseTypeCategory {
  RESIDENTIAL
  COMMERCIAL
  MIXED
  OTHER
}

enum HouseTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum HouseStatus {
  PLANNING
  ALLOCATED
  UNDER_CONSTRUCTION
  INSPECTION
  COMPLETED
  DELIVERED
  ARCHIVED
}

model HouseType {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String?           @db.Uuid
  code             String
  name             String
  category         HouseTypeCategory @default(RESIDENTIAL)
  coveredArea      Decimal?          @db.Decimal(12, 2)
  plotSize         Decimal?          @db.Decimal(12, 2)
  bedrooms         Int?
  bathrooms        Int?
  floors           Int?
  drawingNumber    String?
  description      String?
  status           HouseTypeStatus   @default(ACTIVE)
  defaultTemplateId String?          @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  createdById      String?           @db.Uuid
  updatedById      String?           @db.Uuid

  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultTemplate HouseTemplate?   @relation("HouseTypeDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  templates       HouseTemplate[]  @relation("HouseTypeTemplates")
  houses          House[]

  @@unique([projectId, code])
  @@index([projectId, deletedAt])
  @@index([status, deletedAt])
  @@index([category])
  @@index([name])
  @@index([createdAt])
}

model HouseTemplate {
  id                     String              @id @default(uuid()) @db.Uuid
  houseTypeId            String              @db.Uuid
  projectId              String?             @db.Uuid
  code                   String
  name                   String
  version                Int                 @default(1)
  status                 HouseTemplateStatus @default(DRAFT)
  estimatedDurationDays  Int?
  estimatedCost          Decimal?            @db.Decimal(14, 2)
  /// Placeholder for future Module 11 activity seeding.
  defaultActivities      Json?
  /// Placeholder for future Module 10 BOQ seeding.
  defaultBoq             Json?
  /// Placeholder for future material plan seeding.
  defaultMaterials       Json?
  revisionOfId           String?             @db.Uuid
  revisionNote           String?
  isDefault              Boolean             @default(false)
  description            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  createdById            String?             @db.Uuid
  updatedById            String?             @db.Uuid

  houseType       HouseType      @relation("HouseTypeTemplates", fields: [houseTypeId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionOf      HouseTemplate? @relation("TemplateRevisions", fields: [revisionOfId], references: [id])
  revisions       HouseTemplate[] @relation("TemplateRevisions")
  defaultForTypes HouseType[]    @relation("HouseTypeDefaultTemplate")
  houses          House[]

  @@unique([houseTypeId, code, version])
  @@index([houseTypeId, deletedAt])
  @@index([projectId, deletedAt])
  @@index([status, deletedAt])
  @@index([revisionOfId])
  @@index([createdAt])
}

model House {
  id                  String       @id @default(uuid()) @db.Uuid
  projectId           String       @db.Uuid
  phaseId             String       @db.Uuid
  sectorId            String       @db.Uuid
  blockId             String       @db.Uuid
  houseTypeId         String       @db.Uuid
  houseTemplateId     String?      @db.Uuid
  code                String
  plotNo              String?
  status              HouseStatus  @default(PLANNING)
  statusBeforeArchive HouseStatus?
  gpsLatitude         Decimal?     @db.Decimal(10, 7)
  gpsLongitude        Decimal?     @db.Decimal(10, 7)
  ownerName           String?
  notes               String?      @db.Text
  progressPct         Decimal      @default(0) @db.Decimal(5, 2)
  version             Int          @default(1)
  /// Set when created from a template — future modules seed execution from this.
  seededFromTemplate  Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  createdById         String?      @db.Uuid
  updatedById         String?      @db.Uuid

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         Phase              @relation(fields: [phaseId], references: [id])
  sector        Sector             @relation(fields: [sectorId], references: [id])
  block         Block              @relation(fields: [blockId], references: [id])
  houseType     HouseType          @relation(fields: [houseTypeId], references: [id])
  houseTemplate HouseTemplate?     @relation(fields: [houseTemplateId], references: [id])
  statusHistory HouseStatusHistory[]

  @@unique([blockId, code])
  @@index([projectId, status, deletedAt])
  @@index([projectId, deletedAt])
  @@index([phaseId, deletedAt])
  @@index([sectorId, deletedAt])
  @@index([blockId, deletedAt])
  @@index([houseTypeId])
  @@index([houseTemplateId])
  @@index([plotNo])
  @@index([code])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model HouseStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  houseId     String       @db.Uuid
  projectId   String       @db.Uuid
  fromStatus  HouseStatus?
  toStatus    HouseStatus
  note        String?
  changedById String?      @db.Uuid
  createdAt   DateTime     @default(now())

  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, createdAt])
  @@index([projectId, createdAt])
  @@index([toStatus])
}

/// User-saved list filters (houses module and future lists).
model SavedListFilter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String?  @db.Uuid
  module    String
  name      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@index([projectId, module])
  @@index([createdAt])
}
